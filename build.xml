<?xml version="1.0" encoding="UTF-8"?>
<project name="TucanTrace" default="run" basedir=".">

    <description>TucanTrace - Live UML visualization for Java execution</description>

    <!-- ================================================================
         Propiedades globales
         ================================================================ -->
    <property name="src.dir"        value="src"/>
    <property name="build.dir"      value="build"/>
    <property name="classes.dir"    value="${build.dir}/classes"/>
    <property name="dist.dir"       value="dist"/>
    <property name="lib.dir"        value="lib"/>
    <property name="test.dir"       value="test"/>
    <property name="docs.dir"       value="docs"/>
    <property name="case-study.dir" value="case-study"/>

    <!-- Encoding -->
    <property name="encoding"       value="UTF-8"/>

    <!-- Java version -->
    <property name="javac.source"   value="21"/>
    <property name="javac.target"   value="21"/>

    <!-- Main class -->
    <property name="main.class"     value="tucantrace.Main"/>
    <property name="interactive.class" value="tucantrace.InteractivePrototype"/>

    <!-- ================================================================
         Classpath: clases compiladas + todas las librerías en lib/
         ================================================================ -->
    <path id="project.classpath">
        <pathelement location="${classes.dir}"/>
        <fileset dir="${lib.dir}" includes="*.jar"/>
    </path>

    <path id="test.classpath">
        <path refid="project.classpath"/>
        <pathelement location="${classes.dir}"/>
    </path>

    <!-- ================================================================
         Targets
         ================================================================ -->

    <!-- Inicialización -->
    <target name="init" description="Crea directorios de salida">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${build.dir}/agent"/>
    </target>

    <!-- Compilación principal -->
    <target name="compile" depends="init" description="Compila fuentes principales">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${encoding}"
               includeAntRuntime="false"
               debug="true"
               debuglevel="lines,vars,source">
            <classpath refid="project.classpath"/>
        </javac>
        <!-- Copiar recursos (si los hay) -->
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}" excludes="**/*.java"/>
        </copy>
    </target>

    <!-- Compilación de tests (si existen) -->
    <target name="compile-test" depends="compile" description="Compila tests">
        <mkdir dir="${build.dir}/test-classes"/>
        <javac srcdir="${test.dir}"
               destdir="${build.dir}/test-classes"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${encoding}"
               includeAntRuntime="false"
               debug="true">
            <classpath refid="test.classpath"/>
        </javac>
    </target>

    <!-- Ejecutar la aplicación principal -->
    <target name="run" depends="compile" description="Ejecuta la aplicación demo">
        <java classname="${main.class}"
              classpathref="project.classpath"
              fork="true"
              failonerror="true">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <!-- Descomenta para habilitar JDI (debug mode) -->
            <!-- <jvmarg value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005"/> -->
        </java>
    </target>

    <!-- Ejecutar con agente JDI (para desarrollo del JDIClient) -->
    <target name="run-jdi" depends="compile" description="Ejecuta con JDI habilitado (puerto 5005)">
        <java classname="${main.class}"
              classpathref="project.classpath"
              fork="true"
              failonerror="true">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <jvmarg value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005"/>
        </java>
    </target>

    <!-- Prototipo interactivo (menú por consola) -->
    <target name="interactive" depends="compile" description="Ejecuta el prototipo interactivo con scanner">
        <java classname="${interactive.class}"
              classpathref="project.classpath"
              fork="true"
              failonerror="true">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
        </java>
    </target>

    <!-- Generar JAR ejecutable -->
    <target name="jar" depends="compile" description="Genera JAR ejecutable">
        <jar destfile="${dist.dir}/TucanTrace.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="."/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Build-Date" value="${TODAY}"/>
            </manifest>
            <!-- Incluir librerías en el JAR (opcional: fat-jar) -->
            <!-- <zipgroupfileset dir="${lib.dir}" includes="*.jar"/> -->
        </jar>
    </target>

    <!-- Generar JAR del agente (opcional) -->
    <target name="agent-jar" depends="compile" description="Genera JAR del agente de instrumentación">
        <jar destfile="${build.dir}/agent/TucanTraceAgent.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Premain-Class" value="tucantrace.agent.TraceAgent"/>
                <attribute name="Can-Retransform-Classes" value="true"/>
                <attribute name="Can-Redefine-Classes" value="true"/>
            </manifest>
        </jar>
    </target>

    <!-- Ejecutar tests (si existen) -->
    <target name="test" depends="compile-test" description="Ejecuta tests JUnit 5">
        <junit printsummary="yes" haltonfailure="yes" fork="true">
            <classpath refid="test.classpath"/>
            <formatter type="plain" usefile="false"/>
            <batchtest>
                <fileset dir="${build.dir}/test-classes" includes="**/*Test.class"/>
            </batchtest>
        </junit>
    </target>

    <!-- Limpiar -->
    <target name="clean" description="Limpia directorios de build y dist">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- Limpiar todo incluyendo libs descargadas (cuidado) -->
    <target name="clean-all" depends="clean" description="Limpia todo incluyendo lib/">
        <delete dir="${lib.dir}"/>
    </target>

    <!-- Generar Javadoc -->
    <target name="javadoc" depends="compile" description="Genera Javadoc">
        <mkdir dir="${dist.dir}/javadoc"/>
        <javadoc sourcepath="${src.dir}"
                 destdir="${dist.dir}/javadoc"
                 encoding="${encoding}"
                 author="true"
                 version="true"
                 use="true"
                 windowtitle="TucanTrace API">
            <classpath refid="project.classpath"/>
        </javadoc>
    </target>

    <!-- Verificar dependencias -->
    <target name="check-libs" description="Verifica que existan las librerías necesarias">
        <condition property="libs.ok">
            <and>
                <available file="${lib.dir}/javaparser-core-3.25.0.jar"/>
                <available file="${lib.dir}/plantuml-1.2024.0.jar"/>
                <available file="${lib.dir}/gson-2.10.1.jar"/>
            </and>
        </condition>
        <fail message="Faltan librerías en lib/. Ejecuta 'ant download-libs' o descárgalas manualmente." unless="libs.ok"/>
    </target>

    <!-- Descargar dependencias (requiere internet) -->
    <target name="download-libs" description="Descarga dependencias a lib/">
        <mkdir dir="${lib.dir}"/>
        <get src="https://repo1.maven.org/maven2/com/github/javaparser/javaparser-core/3.25.0/javaparser-core-3.25.0.jar"
             dest="${lib.dir}/javaparser-core-3.25.0.jar" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/net/sourceforge/plantuml/plantuml/1.2023.13/plantuml-1.2023.13.jar"
             dest="${lib.dir}/plantuml-1.2023.13.jar" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/com/google/code/gson/gson/2.10.1/gson-2.10.1.jar"
             dest="${lib.dir}/gson-2.10.1.jar" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/slf4j/slf4j-api/2.0.9/slf4j-api-2.0.9.jar"
             dest="${lib.dir}/slf4j-api-2.0.9.jar" verbose="true"/>
        <get src="https://repo1.maven.org/maven2/org/slf4j/slf4j-simple/2.0.9/slf4j-simple-2.0.9.jar"
             dest="${lib.dir}/slf4j-simple-2.0.9.jar" verbose="true"/>
    </target>

    <!-- Default -->
    <target name="default" depends="run" description="Por defecto: compila y ejecuta"/>

</project>